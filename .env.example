# Public canonical origin. Defaults to this domain when omitted.
# For local form submission testing, override with http://localhost:3000 in .env.local.
# Production builds reject localhost and non-HTTPS origins.
SITE_URL=https://www.tenacom.co.za
# Optional verification token values (not the full meta tags); rebuild after setting.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Server-side delivery configuration (Resend, with a verified sending domain).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional public email address displayed as a simpler contact method.
CONTACT_PUBLIC_EMAIL=
# Only true behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
# Absolute private directory on a persistent volume. Required for manufacturing enquiries.
# Example Windows: C:/TenacomData/manufacturing-enquiries
# Example Linux: /var/lib/tenacom/manufacturing-enquiries
MANUFACTURING_ENQUIRY_DIR=
